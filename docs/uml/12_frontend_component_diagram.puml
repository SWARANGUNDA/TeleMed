@startuml 12_frontend_component_diagram
!theme plain

title TeleMed AI Platform — React Frontend Component & Routing Architecture

package "React Router Application Container (App.jsx)" {
  
  package "Context & State Management" {
    [AuthContext (user, token, role, login, logout)] as AuthCtx
    [Toast / Notification State] as ToastState
  }

  package "Public & Shared Pages" {
    [HomePage.jsx] as Page_Home
    [LoginPage.jsx] as Page_Login
    [RegisterPage.jsx] as Page_Register
    [AboutPage.jsx] as Page_About
  }

  package "Patient Portal Pages" {
    [DashboardPage.jsx] as Page_PatientDash
    [IntakePage.jsx\n(Multimodal Upload / Entry)] as Page_Intake
    [ReportPage.jsx\n(Detailed PDF / Clinical Report)] as Page_Report
    [XAIPage.jsx\n(TreeSHAP Feature Attribution)] as Page_XAI
    [HealthRecordsPage.jsx] as Page_Records
    [CompareAssessmentsPage.jsx] as Page_Compare
    [AppointmentsPage.jsx] as Page_Appointments
    [MessagesPage.jsx] as Page_Messages
  }

  package "Doctor Portal Pages" {
    [DoctorDashboardPage.jsx] as Page_DocDash
    [ConsultationWorkspacePage.jsx] as Page_Consultation
    [DoctorVerificationStatusPage.jsx] as Page_DocVerStatus
  }

  package "Admin Governance Pages" {
    [AdminDashboardPage.jsx] as Page_AdminDash
    [AdminDoctorVerificationPage.jsx] as Page_AdminDocVer
    [AdminAuditPage.jsx] as Page_AdminAudit
    [AdminSystemPage.jsx] as Page_AdminSystem
  }

  package "Reusable UI Component Library" {
    [Navbar.jsx & Footer.jsx] as UI_Layout
    [MultimodalGauge.jsx] as UI_Gauge
    [DiseaseRiskCard.jsx] as UI_RiskCard
    [SHAPSummaryChart.jsx] as UI_SHAPChart
    [ReportPDFView.jsx] as UI_ReportPDF
  }

  package "API Client Services" {
    [apiClient.js (Axios Instance with Auth Interceptor)] as API_Client
  }
}

' Routing & Protection
AuthCtx --> Page_PatientDash : Protected (PATIENT)
AuthCtx --> Page_DocDash : Protected (DOCTOR)
AuthCtx --> Page_AdminDash : Protected (ADMIN)

Page_Intake --> API_Client : POST /api/intake/submit
Page_Report --> API_Client : GET /api/rag/report/{id}
Page_XAI --> API_Client : GET /api/xai/explain/{id}
Page_Consultation --> API_Client : POST /api/consultations

Page_PatientDash --> UI_Gauge
Page_PatientDash --> UI_RiskCard
Page_XAI --> UI_SHAPChart
Page_Report --> UI_ReportPDF

@enduml
