@startuml 03_backend_class_diagram
!theme plain

title TeleMed AI Platform — Backend Class Diagram (FastAPI & SQLAlchemy ORM)

package "models.models (SQLAlchemy 2.x Declarative ORM)" {
  class User {
    +user_id: str {PK}
    +email: str
    +password_hash: str
    +salt: str
    +role: str [PATIENT|DOCTOR|ADMIN]
    +created_at: str
    +updated_at: str
  }

  class PatientProfile {
    +patient_id: str {PK}
    +user_id: str {FK}
    +full_name: str
    +age: int
    +gender: str
    +height_cm: float
    +weight_kg: float
    +contact_number: str
  }

  class DoctorProfile {
    +doctor_id: str {PK}
    +user_id: str {FK}
    +full_name: str
    +specialization: str
    +qualification: str
    +registration_number: str
    +verification_status: str
  }

  class HealthRecord {
    +record_id: str {PK}
    +user_id: str {FK}
    +source_session_id: str
    +pipeline_version: str
    +effective_pathway: str
    +active_modalities: str
    +confirmed_features: str
    +prediction_snapshot: str
    +xai_snapshot: str
    +report_snapshot: str
  }

  class Consultation {
    +consultation_id: str {PK}
    +patient_id: str
    +user_id: str {FK}
    +assigned_doctor_id: str {FK}
    +reason: str
    +status: str
  }

  class ConsultationNote {
    +note_id: str {PK}
    +consultation_id: str {FK}
    +doctor_id: str {FK}
    +assessment: str
    +patient_summary: str
  }

  class AuditEvent {
    +event_id: str {PK}
    +actor_user_id: str
    +role: str
    +action: str
    +resource_type: str
    +prev_hash: str
    +event_hash: str
  }
}

package "services (Business Logic Layer)" {
  class V3InferenceEngine {
    +clinical_payload: dict
    +wearable_payload: dict
    +gut_payload: dict
    +predict_clinical(X): dict
    +predict_wearable(X): dict
    +predict_gut(X): dict
    +predict_multimodal(data): dict
  }

  class V3ScientificRouter {
    +v4_fusion_payload: dict
    +route_prediction(payload): dict
    +evaluate_stasis_pathway(pathway): dict
  }

  class XAIService {
    +get_shap_explanations(record): dict
    +compute_treeshap_attributions(model, X): dict
  }

  class MedicalRAGEngine {
    +chroma_client: object
    +retrieve_medical_evidence(query): list
    +generate_comprehensive_report(snapshot): dict
  }
}

package "api (FastAPI Controller Routers)" {
  class AuthRoutes {
    +login_user(request): JSONResponse
    +register_user(request): JSONResponse
    +get_current_user(token): User
  }

  class PredictRoutes {
    +run_prediction(data, user): JSONResponse
  }

  class XAIRoutes {
    +get_xai_explanation(record_id, user): JSONResponse
  }

  class RAGRoutes {
    +generate_report(record_id, user): JSONResponse
  }

  class ConsultationRoutes {
    +create_consultation(request, user): JSONResponse
    +add_note(consultation_id, note, doctor): JSONResponse
  }
}

' ORM Relationships
User "1" -- "0..1" PatientProfile : patient_profile
User "1" -- "0..1" DoctorProfile : doctor_profile
User "1" -- "0..*" HealthRecord : health_records
PatientProfile "1" -- "0..*" Consultation : consultations
DoctorProfile "1" -- "0..*" Consultation : assigned_consultations
Consultation "1" -- "0..1" ConsultationNote : notes

' Controller to Service Dependencies
PredictRoutes --> V3InferenceEngine : invokes prediction
PredictRoutes --> V3ScientificRouter : invokes fusion
XAIRoutes --> XAIService : requests TreeSHAP
RAGRoutes --> MedicalRAGEngine : requests report generation
ConsultationRoutes --> Consultation : manages entity
AuthRoutes --> User : authenticates

@enduml
