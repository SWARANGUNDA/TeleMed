@startuml 07_patient_assessment_sequence
!theme plain
autonumber

title TeleMed AI Platform — Complete Patient Assessment Sequence Diagram

actor Patient
participant "React Frontend\n(IntakePage.jsx)" as FE
participant "FastAPI Backend\n(intake_routes.py)" as API_Intake
participant "Auth Middleware\n(security.py)" as Auth
participant "Intake Engine\n(intake_service.py)" as Intake
participant "Preprocessing\n(normalizer.py)" as Prep
participant "V4 Expert Models\n(v3_inference_engine.py)" as Experts
participant "Fusion Engine\n(v3_scientific_router.py)" as Fusion
participant "XAI Engine\n(xai_service.py)" as XAI
participant "Medical RAG Engine\n(rag_service_wrapper.py)" as RAG
participant "PostgreSQL Database\n(health_records)" as DB

Patient -> FE : Enter/Upload Multimodal Data (Clinical, Wearable, Gut)
FE -> API_Intake : POST /api/intake/submit (Bearer JWT Token, Payload)
API_Intake -> Auth : verify_jwt_token(token)
Auth --> API_Intake : Token Valid (user_id, role=PATIENT)

API_Intake -> Intake : process_multimodal_intake(raw_payload)
Intake -> Intake : validate_schemas()
Intake -> Intake : detect_active_modalities() -> [C, W, G]

Intake -> Prep : normalize_and_impute_features()
Prep --> Intake : Feature Vectors (Clinical:18, Wearable:15, Gut:49)

Intake -> Experts : execute_active_experts(Clinical, Wearable, Gut)
Experts --> Intake : Expert Probabilities

Intake -> Fusion : route_multimodal_fusion(Expert Probabilities, Pathway="C+W+G")
Fusion --> Intake : Final 5 Disease Probabilities

Intake -> XAI : compute_treeshap_attributions(Record)
XAI --> Intake : XAI Attributions Snapshot

Intake -> RAG : generate_clinical_evidence_report(Prediction Snapshot)
RAG --> Intake : Generated Clinical Report Snapshot

Intake -> DB : save_health_record(user_id, session_id, predictions, XAI, report)
DB --> Intake : record_id Created

Intake --> API_Intake : Assessment Result Payload
API_Intake --> FE : HTTP 200 OK (JSON Assessment Summary & record_id)

FE -> FE : Render Dashboard, Disease Predictions, XAI Plots & PDF Export Option
FE --> Patient : Display Interactive Health Assessment Results

@enduml
