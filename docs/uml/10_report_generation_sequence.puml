@startuml 10_report_generation_sequence
!theme plain
autonumber

title TeleMed AI Platform — Medical RAG & PDF Report Generation Sequence

actor User
participant "React Frontend\n(ReportPage.jsx)" as FE
participant "RAG Router\n(rag_routes.py)" as RAGRouter
participant "PostgreSQL DB" as DB
participant "RAG Service\n(rag_service_wrapper.py)" as RAGService
participant "ChromaDB Store" as ChromaDB
participant "PDF Generator\n(ReportLab Engine)" as PDFGen

User -> FE : View / Request Comprehensive Report
FE -> RAGRouter : GET /api/rag/report/{record_id} (Bearer JWT)
RAGRouter -> DB : fetch_health_record(record_id)
DB --> RAGRouter : HealthRecord (prediction_snapshot)

note right of RAGRouter: Consumes stored prediction snapshot.\nDoes NOT re-run ML model inference.

alt Report Snapshot Cached
  RAGRouter --> FE : Return Cached Report JSON
else Report Snapshot Not Cached
  RAGRouter -> RAGService : generate_report_from_snapshot(prediction_snapshot)
  
  loop For Each High-Risk Condition
    RAGService -> ChromaDB : query_medical_evidence(disease_name, risk_level)
    ChromaDB --> RAGService : Relevant Guidelines, Lifestyle Recommendations, Interventions
  end
  
  RAGService -> RAGService : Synthesize Multimodal Findings, Evidence & Recommendations
  RAGService --> RAGRouter : Structured Report Payload
  
  RAGRouter -> DB : UPDATE health_records SET report_snapshot = JSON
  DB --> RAGRouter : Confirmed
  
  RAGRouter --> FE : HTTP 200 OK (Structured Clinical Report JSON)
end

opt User Clicks "Download PDF Report"
  User -> FE : Click Download PDF
  FE -> RAGRouter : GET /api/rag/report/{record_id}/pdf
  RAGRouter -> PDFGen : build_pdf_document(report_snapshot)
  PDFGen --> RAGRouter : PDF Binary Stream (Bytes)
  RAGRouter --> FE : HTTP 200 OK (application/pdf)
  FE --> User : Download PDF File
end

@enduml
