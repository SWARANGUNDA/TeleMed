@startuml 16_v4_model_architecture
!theme plain

title TeleMed AI Platform — Frozen V4 Multi-Expert Model Ecosystem

package "Metadata & Labels (Strictly Excluded from Model Inputs)" {
  [Patient_ID] as Metadata_ID
  [Disease Labels] as Target_Labels
  note bottom of Metadata_ID: Metadata only; MUST NEVER enter ML feature vector
  note bottom of Target_Labels: Target labels only; NEVER model inputs
}

package "Frozen V4 Modality Feature Schemas" {
  package "Clinical Expert Input Schema (18 Features)" {
    [Clinical Biomarkers Vector] as Clin_Vector
    note right of Clin_Vector
      Includes: Age, Gender, Height, Weight, BMI,
      Waist_Circumference, Systolic_BP, Diastolic_BP,
      Fasting_Blood_Glucose, HbA1c, Triglycerides,
      HDL, LDL, ALT, AST, Family_History_Diabetes,
      Family_History_Hypertension, Family_History_CVD
    end note
  }

  package "Wearable Expert Input Schema (15 Features)" {
    [Wearable & CGM Metrics Vector] as Wear_Vector
    note right of Wear_Vector
      Includes 15 CGM & Wearable metrics:
      Average_Daily_Steps, Active_Minutes, Sedentary_Time,
      Resting_Heart_Rate, HRV_RMSSD, Sleep_Duration,
      Sleep_Efficiency, Autonomic_Stress, Activity_Energy,
      Exercise_Frequency, CGM_Average_Glucose, CGM_Glucose_CV,
      CGM_Time_In_Range, CGM_Time_Above_Range, CGM_Time_Below_Range
      (EXCLUDES Age, Gender, Patient_ID)
    end note
  }

  package "Gut Microbiome Input Schema (49 Features)" {
    [Microbiome Taxa & Indices Vector] as Gut_Vector
    note right of Gut_Vector
      Includes 49 V4 Features:
      - 40 Canonical Taxa (Akkermansia, Faecalibacterium, Roseburia, etc.)
      - 1 Other_Taxa
      - 9 Derived Ecological Indices:
        * Shannon_Diversity
        * Simpson_Diversity
        * Observed_Richness
        * Pielou_Evenness
        * SCFA_Producer_Index
        * Butyrate_Producer_Index
        * Barrier_Associated_Index
        * Inflammation_Associated_Index
        * Log_Firmicutes_Bacteroidetes_Ratio
      (EXCLUDES Age, Gender, Patient_ID)
    end note
  }
}

package "Frozen V4 Expert Classifier Payloads" {
  [Clinical Expert Classifier] as Clin_Classifier
  [Wearable Expert Classifier] as Wear_Classifier
  [Gut Expert Classifier] as Gut_Classifier
}

package "V4 Multimodal Stacking Fusion Engine" {
  [Multimodal Stacking Meta-Learner\n(Logistic Regression Meta-Models)] as Stacking_Meta
  [Dynamic Calibrator & Threshold Engine] as Threshold_Engine
}

package "5 Multi-Organ Disease Targets" {
  [1. Type 2 Diabetes] as Dis_T2D
  [2. Prediabetes] as Dis_Prediabetes
  [3. High Adiposity Risk] as Dis_Adiposity
  [4. Metabolic Syndrome] as Dis_MetSyndrome
  [5. NAFLD (Non-Alcoholic Fatty Liver)] as Dis_NAFLD
}

' Connections
Clin_Vector --> Clin_Classifier : Input 18 Features
Wear_Vector --> Wear_Classifier : Input 15 Features
Gut_Vector --> Gut_Classifier : Input 49 Features

Clin_Classifier --> Stacking_Meta : Clinical Risk Probability
Wear_Classifier --> Stacking_Meta : Wearable Risk Probability
Gut_Classifier --> Stacking_Meta : Gut Risk Probability

Stacking_Meta --> Threshold_Engine
Threshold_Engine --> Dis_T2D
Threshold_Engine --> Dis_Prediabetes
Threshold_Engine --> Dis_Adiposity
Threshold_Engine --> Dis_MetSyndrome
Threshold_Engine --> Dis_NAFLD

@enduml
