@startuml 04_intake_preprocessing_class_diagram
!theme plain

title TeleMed AI Platform — Data Intake & Preprocessing Class Diagram (V4 Schema)

package "multimodal_data_intake_engine" {
  
  class MultimodalIntakeEngine {
    +schema_validator: SchemaValidator
    +modality_detector: ModalityDetector
    +normalizer: FeatureNormalizer
    +process_intake(raw_payload: dict): IntakeResult
    +extract_from_csv(csv_path: Path): dict
    +extract_from_pdf_ocr(pdf_path: Path): dict
  }

  class SchemaValidator {
    +clinical_schema: dict
    +wearable_schema: dict
    +gut_schema: dict
    +validate_clinical_features(raw_data: dict): ValidationReport
    +validate_wearable_features(raw_data: dict): ValidationReport
    +validate_gut_features(raw_data: dict): ValidationReport
  }

  class ModalityDetector {
    +detect_active_modalities(payload: dict): list [C, W, G]
    +determine_effective_pathway(modalities: list): str
  }

  class FeatureNormalizer {
    +clinical_medians: dict
    +wearable_medians: dict
    +gut_medians: dict
    +normalize_clinical(data: dict): np.ndarray (18)
    +normalize_wearable(data: dict): np.ndarray (15)
    +normalize_gut(data: dict): np.ndarray (49)
    +compute_v4_gut_indices(taxa_dict: dict): dict (9 indices)
  }

  class IntakeResult {
    +session_id: str
    +patient_id: str {metadata only}
    +active_modalities: list
    +effective_pathway: str
    +data_quality_score: float
    +clinical_vector: np.ndarray (18 features)
    +wearable_vector: np.ndarray (15 features)
    +gut_vector: np.ndarray (49 features)
  }
}

package "V4 Frozen Feature Schemas" {
  class ClinicalSchema18 {
    +Age: float {Included}
    +Gender: int [0|1] {Included}
    +Height: float
    +Weight: float
    +BMI: float
    +Waist_Circumference: float
    +Systolic_BP: float
    +Diastolic_BP: float
    +Fasting_Blood_Glucose: float
    +HbA1c: float
    +Triglycerides: float
    +HDL: float
    +LDL: float
    +ALT: float
    +AST: float
    +Family_History_Diabetes: int
    +Family_History_Hypertension: int
    +Family_History_CVD: int
  }

  class WearableSchema15 {
    +Average_Daily_Steps: float
    +Active_Minutes: float
    +Sedentary_Time_Minutes: float
    +Resting_Heart_Rate: float
    +Heart_Rate_Variability_RMSSD: float
    +Sleep_Duration_Hours: float
    +Sleep_Efficiency_Score: float
    +Autonomic_Stress_Score: float
    +Activity_Energy_Expenditure: float
    +Exercise_Frequency_Days: float
    +CGM_Average_Glucose: float
    +CGM_Glucose_CV: float
    +CGM_Time_In_Range: float
    +CGM_Time_Above_Range: float
    +CGM_Time_Below_Range: float
    note right: Excludes Age, Gender, Patient_ID
  }

  class GutSchema49 {
    +Canonical_Taxa_40: float [40 species]
    +Other_Taxa: float [1 feature]
    +Derived_Indices_9: float [9 ecological indices]
    -- 9 Ecological Indices --
    +Shannon_Diversity: float
    +Simpson_Diversity: float
    +Observed_Richness: float
    +Pielou_Evenness: float
    +SCFA_Producer_Index: float
    +Butyrate_Producer_Index: float
    +Barrier_Associated_Index: float
    +Inflammation_Associated_Index: float
    +Log_Firmicutes_Bacteroidetes_Ratio: float
    note right: Excludes Age, Gender, Patient_ID
  }
}

note "Patient_ID is Metadata Only\nTarget Labels are Never Model Inputs" as MetadataNote

MultimodalIntakeEngine --> SchemaValidator
MultimodalIntakeEngine --> ModalityDetector
MultimodalIntakeEngine --> FeatureNormalizer
MultimodalIntakeEngine ..> IntakeResult : produces

FeatureNormalizer ..> ClinicalSchema18 : outputs 18 features
FeatureNormalizer ..> WearableSchema15 : outputs 15 features
FeatureNormalizer ..> GutSchema49 : outputs 49 features

@enduml
