@startuml 08_multimodal_prediction_sequence
!theme plain
autonumber

title TeleMed AI Platform — Multimodal Prediction & Modality Execution Sequence

participant "Client API / Frontend" as Client
participant "Predict Router\n(predict_routes.py)" as PredictRouter
participant "Modality Detector" as Detector
participant "Clinical Expert (C)" as ClinExp
participant "Wearable Expert (W)" as WearExp
participant "Gut Expert (G)" as GutExp
participant "Stacking Fusion Engine" as FusionEngine
participant "Database Persistence" as DB

Client -> PredictRouter : POST /api/v3/predict (Multimodal Payload)
PredictRouter -> Detector : detect_modalities(payload)

alt Modality Pathway = C (Clinical Only)
  Detector -> ClinExp : Run Clinical Model (18 features)
  ClinExp --> PredictRouter : Probabilities_C
  PredictRouter -> FusionEngine : Pass Single Modality (C)
else Modality Pathway = W (Wearable Only)
  Detector -> WearExp : Run Wearable Model (15 features)
  WearExp --> PredictRouter : Probabilities_W
  PredictRouter -> FusionEngine : Pass Single Modality (W)
else Modality Pathway = G (Gut Only)
  Detector -> GutExp : Run Gut Model (49 features)
  GutExp --> PredictRouter : Probabilities_G
  PredictRouter -> FusionEngine : Pass Single Modality (G)
else Modality Pathway = C+W+G (Tri-Modal)
  Detector -> ClinExp : Run Clinical Model (18 features)
  ClinExp --> PredictRouter : Probabilities_C
  Detector -> WearExp : Run Wearable Model (15 features)
  WearExp --> PredictRouter : Probabilities_W
  Detector -> GutExp : Run Gut Model (49 features)
  GutExp --> PredictRouter : Probabilities_G
  PredictRouter -> FusionEngine : Stack (Probabilities_C, Probabilities_W, Probabilities_G)
end

FusionEngine -> FusionEngine : Apply Meta-Learner Weights & Calibrated Thresholds
FusionEngine --> PredictRouter : Final 5 Disease Risk Scores\n(Type2_Diabetes, Prediabetes, High_Adiposity_Risk, Metabolic_Syndrome, NAFLD)

PredictRouter -> DB : Insert Prediction Snapshot into health_records
DB --> PredictRouter : Confirm Persistence

PredictRouter --> Client : HTTP 200 OK (5 Disease Probabilities & Effective Pathway)

@enduml
