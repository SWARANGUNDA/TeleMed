{
  "version": 2,
  "buildCommand": "npm --prefix app/frontend run build",
  "outputDirectory": "app/frontend/dist",
  "installCommand": "npm --prefix app/frontend install",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://telemed-ai-backend.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/v3/:path*",
      "destination": "https://telemed-ai-backend.onrender.com/api/v3/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://telemed-ai-backend.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
